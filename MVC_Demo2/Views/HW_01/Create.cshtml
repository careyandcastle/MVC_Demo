@using MVC_Demo2.Models.ViewModel;
@using MVC_Demo2.Controllers;
@model HW_01_庫存盤點主檔BasicViewModel

<div>
    <div class="row">
        <div class="col">
            <form asp-action="Create">
                @* 全域錯誤訊息區塊 *@
                <div id="ModelErrorDiv" class="validation-summary-valid text-danger">
                    <ul></ul>
                </div>

                @* 顯示用：進銷存組織、列帳年月、列帳日期 *@
                <div class="form-group">
                    <label class="control-label">進銷存組織</label>
                    <input class="form-control" value="@ViewBag.var進銷存組織" disabled />
                </div>

                @*<div class="form-group">
            <label class="control-label">列帳年月</label>
            <input class="form-control" value="@ViewBag.var列帳年月" disabled />
        </div>*@

                <div class="form-group">
                    <label class="control-label">日期</label>
                    <input class="form-control" value="@ViewBag.var列帳日期" disabled />
                </div>

                @* 不顯示：單據別、流水號、修改人、修改時間 *@
                <input type="hidden" asp-for="單據別" />
                <input type="hidden" asp-for="流水號" />
                <input type="hidden" asp-for="進銷存組織" />

                @*<input type="hidden" asp-for="修改人" />
        <input type="hidden" asp-for="修改日期時間" />*@

                @*<div class="form-group">
            <label asp-for="日期" class="control-label"></label>
            <input asp-for="日期" class="form-control" />
            <span asp-validation-for="日期" class="text-danger"></span>
        </div>*@

                <div class="form-group">
                    <label asp-for="倉庫代號" class="control-label"></label>
                    <select asp-for="倉庫代號" class="form-control" asp-items="@ViewBag.倉庫選項"></select>
                    <span asp-validation-for="倉庫代號" class="text-danger"></span>
                </div>

                @*<div class="form-group">
            <label asp-for="盤點種類" class="control-label"></label>
            <select asp-for="盤點種類" class="form-control" asp-items="@ViewBag.盤點種類選項"></select>
            <span asp-validation-for="盤點種類" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="災害別" class="control-label"></label>
            <select asp-for="災害別" class="form-control" asp-items="@ViewBag.災害別選項"></select>
            <span asp-validation-for="災害別" class="text-danger"></span>
        </div>*@

                <div class="form-group">
                    <label asp-for="盤點種類" class="control-label"></label>
                    <select asp-for="盤點種類" class="form-control" asp-items="@ViewBag.盤點種類選項" id="inventory-type-sel"></select>
                    <span asp-validation-for="盤點種類" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="災害別" class="control-label"></label>
                    @*<select asp-for="災害別" class="form-control" id="disaster-sel"></select>*@
                    <select asp-for="災害別" class="form-control" asp-items="@ViewBag.災害別選項" id="disaster-sel"></select>
                    <span asp-validation-for="災害別" class="text-danger"></span>
                </div>



                <div class="form-group">
                    <label asp-for="盤點人" class="control-label"></label>
                    <select asp-for="盤點人" class="form-control" asp-items="@ViewBag.盤點人選項"></select>
                    <span asp-validation-for="盤點人" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="盤點日期" class="control-label"></label>
                    <input asp-for="盤點日期" class="form-control" />
                    <span asp-validation-for="盤點日期" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="備註" class="control-label"></label>
                    <textarea asp-for="備註" class="form-control" rows="3"></textarea>
                    @*<textarea asp-for="備註" class="form-control" rows="3">@Model.備註</textarea>*@

                    <span asp-validation-for="備註" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="送出" class="btn btn-primary" :disabled="isWaitting" />
                </div>
            </form>
        </div>
    </div>
</div>
<script>
this.$on('fetched-page-modal::ready', () => {
    console.log("[Modal Ready] 綁定盤點種類下拉選單 change 事件");

    $('#inventory-type-sel').change(function () {
        const selectedType = $(this).val();
        console.log(`[ChangeEvent] 使用者選擇盤點種類：${selectedType}`);

        const apiUrl = '@Url.Action("依盤點種類取得災害別", "HW_01")';
        console.log(`[API] 呼叫 URL：${apiUrl}，參數：{ 盤點種類: "${selectedType}" }`);

        $.get(apiUrl, { 盤點種類: selectedType }, function (data) {
            const $disasterSel = $('#disaster-sel');
            $disasterSel.empty();
            console.log(`[DOM] 已清空災害別下拉選單`);

            if (data.length === 0) {
                console.log(`[API Response] 此盤點種類無災害別（data.length = 0）`);
                $disasterSel.append($('<option>').val("").text("（此盤點類型無需選擇災害別）"));
            } else {
                console.log(`[API Response] 成功載入災害別選項，共 ${data.length} 筆`);
                $disasterSel.append($('<option>').val("").text("請選擇災害別"));

                $.each(data, function (_, item) {
                    $disasterSel.append($('<option></option>')
                        .val(item.Value)
                        .text(item.Text));
                });

                console.log(`[DOM] 已更新災害別選單`);
            }
        }).fail(function (xhr, status, error) {
            console.error(`[API Error] 呼叫失敗：${status} - ${error}`);
        });
    });
});
</script>
