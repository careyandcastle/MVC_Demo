@model MVC_Demo2.Models.ViewModel.HW_01_庫存盤點明細檔CreateViewModel
@{
    ViewData["Title"] = "輸入個資盤點品項";
}

<div class="container-fluid">
    <h4 class="text-primary mb-3">@ViewData["Title"]</h4>
    <div class="row">
        <div class="col-md-12">

            <form asp-action="CreateMultiInput" method="post">
                @Html.AntiForgeryToken()

                <!-- 顯示欄位區域 -->
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label">倉庫簡稱</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" value="@ViewBag.倉庫簡稱" readonly />
                    </div>

                    <label class="col-sm-2 col-form-label">庫存日期</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" value="@ViewBag.var列帳日期" readonly />

                        @*<input type="text" class="form-control" value="@(((DateTime?)ViewBag.var列帳日期)?.ToString("yyyy/MM/dd"))" readonly />*@
                    </div>
                </div>

                <!-- 商品編號下拉選單 -->
                <div class="form-group row">
                    <label asp-for="商品編號" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        @*<select asp-for="商品編號" class="form-control" asp-items="ViewBag.品項選項"></select>*@
                        <select asp-for="商品編號" class="form-control" asp-items="ViewBag.品項選項" id="product-sel"></select>

                        <span asp-validation-for="商品編號" class="text-danger"></span>
                    </div>
                </div>

                <!-- 加入盤點按鈕 -->
                <div class="form-group">
                    <button type="button" class="btn btn-success" id="btnAddItem">加入盤點</button>
                </div>

                <!-- 列示區（動態加入） -->
                <table class="table table-bordered table-sm" id="item-list-table">
                    <thead class="thead-light">
                        <tr>
                            <th>刪除</th>
                            <th>商品編號</th>
                            <th>商品名稱</th>
                            <th>庫存商品量</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 由 JS 動態加入 -->
                    </tbody>
                </table>

                <!-- 隱藏原始鍵值 -->
                @Html.HiddenFor(m => m.進銷存組織)
                @Html.HiddenFor(m => m.單據別)
                @Html.HiddenFor(m => m.日期)
                @Html.HiddenFor(m => m.流水號)

                <!-- 存檔/關閉按鈕 -->
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary" id="btnSave" style="display: none;">存檔</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">關閉</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    this.$on('fetched-page-modal::ready', (modalId) => {
        console.log(`[Modal Ready] modalId = ${modalId}`);

        let itemMap = new Map();

        const $btnAdd = $('#btnAddItem');
        const $btnSave = $('#btnSave');
        const $select = $('#product-sel'); // ✅ 使用你設定的 id
        const $tbody = $('#item-list-table tbody');

        console.log("✅ Init Select Option Count:", $select.find('option').length);

        $btnAdd.off('click').on('click', function () {
            console.log("📌 [事件] 點擊「加入盤點」按鈕");

            const 商品編號 = $select.val();
            const 商品名稱 = $select.find('option:selected').text();
            const 假庫存量 = Math.floor(Math.random() * 50);

            console.log("🎯 選擇商品：", 商品編號, 商品名稱);

            if (!商品編號 || itemMap.has(商品編號)) {
                console.warn("⚠️ 商品重複或為空");
                return;
            }

            const row = `
        <tr data-id="${商品編號}">
            <td><button type="button" class="btn btn-sm btn-danger btn-remove">刪除</button></td>
            <td><input type="hidden" name="選項清單[].商品編號" value="${商品編號}" />${商品編號}</td>
            <td>${商品名稱}</td>
            <td>${假庫存量}</td>
        </tr>
        `;

            $tbody.append(row);
            itemMap.set(商品編號, true);
            $btnSave.show();

            console.log(`✅ 已加入：${商品編號}`);
        });

        $tbody.off('click').on('click', '.btn-remove', function () {
            const tr = $(this).closest('tr');
            const 商品編號 = tr.data('id');
            tr.remove();
            itemMap.delete(商品編號);
            console.log(`🗑️ 移除商品：${商品編號}`);
            if (itemMap.size === 0) $btnSave.hide();
        });
    });

</script>
