@model MVC_Demo2.Models.ViewModel.HW_01_庫存盤點明細檔CreateViewModel
@{
    ViewData["Title"] = "輸入個別盤點品項";
}

<div class="container-fluid">
    <h4 class="text-primary mb-3">@ViewData["Title"]</h4>
    <div class="row">
        <div class="col-md-12">

            <form asp-action="CreateMultiInput" method="post">
                @Html.AntiForgeryToken()

                <!-- 顯示欄位區域 -->
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label">倉庫簡稱</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" value="@ViewBag.倉庫簡稱" readonly />
                    </div>

                    <label class="col-sm-2 col-form-label">庫存日期</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" value="@ViewBag.var列帳日期" readonly />

                        @*<input type="text" class="form-control" value="@(((DateTime?)ViewBag.var列帳日期)?.ToString("yyyy/MM/dd"))" readonly />*@
                    </div>
                </div>

                <!-- 商品編號下拉選單 -->
                <div class="form-group row">
                    <label asp-for="商品編號" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        @*<select asp-for="商品編號" class="form-control" asp-items="ViewBag.品項選項"></select>*@
                        <select asp-for="商品編號" class="form-control" asp-items="ViewBag.品項選項" id="product-sel"></select>

                        <span asp-validation-for="商品編號" class="text-danger"></span>
                    </div>
                </div>

                <!-- 加入盤點按鈕 -->
                <div class="form-group">
                    <button type="button" class="btn btn-success" id="btnAddItem">加入盤點</button>
                </div>

                <!-- 列示區（動態加入） -->
                <table class="table table-bordered table-sm" id="item-list-table">
                    <thead class="thead-light">
                        <tr>
                            <th>刪除</th>
                            <th>商品編號</th>
                            <th>商品名稱</th>
                            <th>庫存商品量</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 由 JS 動態加入 -->
                    </tbody>
                </table>

                <!-- 隱藏原始鍵值 -->
                @Html.HiddenFor(m => m.進銷存組織)
                @Html.HiddenFor(m => m.單據別)
                @Html.HiddenFor(m => m.日期)
                @Html.HiddenFor(m => m.流水號)
                @Html.HiddenFor(m => m.倉庫代號)
                <!-- 存檔/關閉按鈕 -->
                <div class="form-group mt-4">
                    @*<button type="submit" class="btn btn-primary" id="btnSave" style="display: none;">存檔</button>*@
                    <button type="button" class="btn btn-primary" id="btnSave" style="display: none;">存檔</button>

                    <button type="button" class="btn btn-secondary" data-dismiss="modal">關閉</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
this.$on('fetched-page-modal::ready', (modalId) => {
    console.log(`[Modal Ready] modalId = ${modalId}`);

    this.$nextTick(() => {
        let itemMap = new Map();

        const $btnAdd = $('#btnAddItem');
        const $btnSave = $('#btnSave');
        const $select = $('#product-sel');
        const $tbody = $('#item-list-table tbody');
 
        const getStockQty = async (商品編號) => {
    try {
 
        console.log("📤 查詢參數 = ", {
            進銷存組織: $('input[name="進銷存組織"]').val(),
            倉庫代號: $('input[name="倉庫代號"]').val(),
            @*日期: $('input[name="日期"]').val(),*@
            日期: '@ViewBag.var列帳日期',
            單據別: $('input[name="單據別"]').val(),
            流水號: $('input[name="流水號"]').val(),
            商品編號: 商品編號
        });
            const res = await axios.post('@Url.Action("GetStockQty", "HW_01")', {
        進銷存組織: $('input[name="進銷存組織"]').val(),
        倉庫代號: $('input[name="倉庫代號"]').val(),
        單據別: $('input[name="單據別"]').val(),
        @*日期: $('input[name="日期"]').val(),*@
        日期: '@ViewBag.var列帳日期',
        流水號: parseInt($('input[name="流水號"]').val(), 10),
        商品編號: 商品編號
    }, {
        headers: {
            'Content-Type': 'application/json'
        }
    });



        console.log(`📦 查詢盤點明細庫存成功：${商品編號} => ${res.data.結存數量}`);
        return res.data || 0;
    } catch (err) {
        console.error("❌ 查詢盤點明細庫存量失敗", err);
        return 0;
    }
};

        $btnAdd.off('click').on('click', async function () {
            const 商品編號 = $select.val();
            const 商品名稱 = $select.find('option:selected').text();

            if (!商品編號) {
                alert("⚠️ 請先選擇商品");
                return;
            }

            if (itemMap.has(商品編號)) {
                alert("⚠️ 此商品已加入，請勿重複");
                return;
            }

            console.log(`🔍 查詢商品：${商品編號} - ${商品名稱}`);
            @*const 庫存商品量 = await getStockQty(商品編號);*@
            const result = await getStockQty(商品編號);
            const 庫存商品量 = result.結存數量;
            @*const 商品名稱 = result.商品簡稱;*@
            const row = `
                <tr data-id="${商品編號}">
                    <td><button type="button" class="btn btn-sm btn-danger btn-remove">刪除</button></td>
                    <td>${商品編號}<input type="hidden" name="選項清單[].商品編號" value="${商品編號}" /></td>
                    <td>${商品名稱}</td>
                    <td>${庫存商品量}<input type="hidden" name="選項清單[].庫存商品量" value="${庫存商品量}" /></td>
                </tr>`;
            $tbody.append(row);
            itemMap.set(商品編號, true);
            $btnSave.show();
            console.log(`✅ 已成功加入商品：${商品編號}`);
        });

        $btnSave.off('click').on('click', async function () {
            console.log("📝 點擊送出按鈕");

            const rows = $tbody.find('tr');
            console.log(`📋 當前列示品項筆數：${rows.length}`);

            if (rows.length === 0) {
                alert("⚠️ 請至少加入一筆盤點品項");
                console.warn("🚫 無可送出資料");
                return;
            }

            const 選項清單 = [];
            rows.each(function (i) {
                const 商品編號 = $(this).data('id');
                const 商品名稱 = $(this).find('td:eq(2)').text();
                const 庫存商品量 = parseInt($(this).find('td:eq(3)').text());

                if (!商品編號 || isNaN(庫存商品量)) {
                    console.warn(`⚠️ 第 ${i + 1} 筆資料無效，略過`);
                    return;
                }

                console.log(`📌 收集第 ${i + 1} 筆：${商品編號}, ${商品名稱}, 庫存=${庫存商品量}`);
                選項清單.push({ 商品編號, 商品名稱, 庫存商品量 });
            });

            const postData = {
                進銷存組織: $('input[name="進銷存組織"]').val(),
                單據別: $('input[name="單據別"]').val(),
                日期: $('input[name="日期"]').val(),
                @*日期: '@ViewBag.var列帳日期',*@
                流水號: parseInt($('input[name="流水號"]').val()),
                倉庫代號: $('input[name="倉庫代號"]').val(),
                選項清單: 選項清單
            };

            console.log("📤 送出資料 postData =", postData);

            try {
                const response = await axios.post('@Url.Action("CreateMultiInput", "HW_01")', postData, {
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                });

                console.log("✅ 成功送出，伺服器回應：", response.data);
                alert("🎉 已成功送出盤點品項！");
                window.location.reload();
            } catch (error) {
                console.error("❌ 發生錯誤", error);

                if (error.response) {
                    console.warn("📨 錯誤回應內容：", error.response.data);
                    alert("❌ 發生錯誤：" + error.response.data);
                } else {
                    alert("❌ 發生未知錯誤，請查看 Console");
                }
            }
        });

        $tbody.off('click').on('click', '.btn-remove', function () {
            const tr = $(this).closest('tr');
            const 商品編號 = tr.data('id');
            tr.remove();
            itemMap.delete(商品編號);
            console.log(`🗑️ 已移除商品：${商品編號}`);

            if (itemMap.size === 0) {
                $btnSave.hide();
                console.log("📭 所有品項已清空，隱藏送出按鈕");
            }
        });
    });
});
</script>
